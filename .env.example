# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/tapin"

# Session auth (jose)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Fingerprint companion bridge (optional — see docs/fingerprint-integration.md)
# Defaults to http://127.0.0.1:8787 if unset.
# NEXT_PUBLIC_FINGERPRINT_BRIDGE_URL="http://127.0.0.1:8787"
