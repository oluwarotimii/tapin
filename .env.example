# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/tapin"

# Session auth (jose)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Timezone — the school's local zone. Schedule windows, tap day/time, and ADMS
# punch parsing all use server-local time, so this must match the terminal.
TZ=Asia/Manila

# ADMS (ZKTeco push) receiver — see docs/adms-integration.md
# Comma-separated device serial allowlist. When unset, any serial is accepted
# and auto-registered (fine for setup, not for production).
# ADMS_ALLOWED_SERIALS=""
# ADMS_DEVICE_NAME="ZKTeco device"

# Fingerprint companion bridge (optional — see docs/fingerprint-integration.md)
# Defaults to http://127.0.0.1:8787 if unset.
# NEXT_PUBLIC_FINGERPRINT_BRIDGE_URL="http://127.0.0.1:8787"
