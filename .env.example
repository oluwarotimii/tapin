# Copy this file to .env (via cPanel File Manager: duplicate, rename the
# copy to ".env", then edit the values below) and fill in real secrets.
# .env itself is gitignored — never commit it.

# cPanel's local PostgreSQL. Use the literal 127.0.0.1, not "localhost" —
# this server's pg_hba.conf only has a rule for the IPv4 loopback address.
# If the password contains special characters (?, {, [, @, #, %, ^, etc.),
# percent-encode them: @->%40  #->%23  %->%25  ?->%3F  {->%7B  [->%5B  ^->%5E
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME"

# Session auth (jose). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

NEXT_TELEMETRY_DISABLED=1
