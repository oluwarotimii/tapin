generator client {
  provider = "prisma-client-js"
  // cPanel's exact Linux distro/OpenSSL version isn't known ahead of
  // time (shared hosting), and the server can't run `prisma generate`
  // itself — so the client is generated locally and bundled into the
  // dist branch with binaries for the common cPanel host families
  // (RHEL/AlmaLinux/CloudLinux, both OpenSSL 1.0 and 3.0 builds).
  // debian-openssl-3.0.x is ALSO required: cPanel's jailed shell
  // (CageFS) hides distro info from Prisma's platform detection, which
  // then unconditionally falls back to "debian" even on a real RHEL
  // host, regardless of what's actually installed. debian-openssl-1.1.x
  // on top of that: the target box has both libssl.so.1.1 and
  // libssl.so.3 installed side by side, and Prisma's version sniffing
  // picked "1.1.x" over the box's real, newer OpenSSL 3.5.8.
  binaryTargets = ["rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

enum ApiKeyScope {
  students_read
  students_write
  schedules_read
  schedules_write
  attendance_read
  attendance_write
  taps_write
  cards_write
  fingerprints_write
}

model ApiKey {
  id         String        @id @default(cuid())
  name       String
  prefix     String        @unique
  keyHash    String        @unique
  scopes     ApiKeyScope[]
  active     Boolean       @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  expiresAt  DateTime?
}

enum StudentStatus {
  active
  inactive
}

model Student {
  id        String        @id @default(cuid())
  studentId String        @unique
  name      String
  status    StudentStatus @default(active)
  cardId    String?       @unique
  createdAt DateTime      @default(now())
  schedule  ScheduleDay[]
  attendance AttendanceRecord[]
  session   ActiveSession?
  fingerprintTemplate FingerprintTemplate?
}

// One enrolled fingerprint per student — enrolling again replaces it
// (src/server/students.ts's enrollFingerprint upserts on studentId).
model FingerprintTemplate {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  finger    String
  template  Bytes
  createdAt DateTime @default(now())
}

model ScheduleDay {
  id             String   @id @default(cuid())
  day            String
  start          String
  end            String
  minimumMinutes Int
  studentId      String?
  student        Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([day, start, end, minimumMinutes, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  complete
  incomplete
  in_progress
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date            String
  clockIn         String
  clockOut        String?
  durationMinutes Int?
  status          AttendanceStatus @default(in_progress)
  override        Boolean          @default(false)
  source          String           @default("tap")

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId, date])
}

model ActiveSession {
  id          String   @id @default(cuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cardId      String?
  clockedInAt DateTime @default(now())
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ── ZKTeco ADMS (push) devices ──────────────────────────────────────────────
// The UA300 (and other ZKTeco terminals) connect outbound to this app over
// the ADMS/push protocol and POST attendance punches to /iclock/cdata. The
// device keeps the fingerprint templates and does its own 1:N match; we only
// receive the resulting PIN + timestamp. See docs/adms-integration.md.
model Device {
  id         String        @id @default(cuid())
  serial     String        @unique
  name       String        @default("ZKTeco device")
  enabled    Boolean       @default(true)
  lastSeenAt DateTime?
  // Last `Stamp` the device reported. Echoed back on the next handshake so
  // the device resumes instead of re-pushing its entire log every poll.
  lastStamp  Int           @default(0)
  createdAt  DateTime      @default(now())
  punches    DevicePunch[]
}

// Raw punch log, one row per device ATTLOG line. The unique constraint is
// the idempotency guard: ADMS re-sends unacknowledged batches, and the same
// (device, pin, timestamp) must never be applied twice.
model DevicePunch {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pin        String
  punchedAt  DateTime
  status     String   @default("")
  verifyMode String   @default("")
  workCode   String   @default("")
  // TapResult.kind after applying the punch ("clocked_in", "clocked_out",
  // "too_early", "already_complete", "not_recognized"). Null until processed.
  result     String?
  createdAt  DateTime @default(now())

  @@unique([deviceId, pin, punchedAt])
  @@index([deviceId, punchedAt])
  @@index([punchedAt])
}
